<div class="position-relative" style="min-height: 120px;">
    @if (!IsEditing)
    {
        <div class="position-absolute d-flex align-items-center gap-2" style="top:8px; right:8px;">
            @if (CanChangePublicFlag)
            {
                <label class="form-check form-check-inline mb-0">
                    <input class="form-check-input"
                           type="checkbox"
                           checked="@IsPublic"
                           @onchange="HandlePublicChangedAsync" />
                    <span class="form-check-label">Общий</span>
                </label>
            }
            @if (Entity != null)
            {
                <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1"
                   title="Печать"
                   href="@($"/print/{Entity.Id}")">
                    <span class="material-icons" aria-hidden="true" style="font-size: 1rem; line-height: 1;">print</span>
                    <span>Печать</span>
                </a>
            }
            @if (CanEdit)
            {
                <button class="btn btn-sm" title="Edit"
                        style="background:#9c27b0; color:white; border-color:#9c27b0;"
                        @onclick="EnterEditMode">
                    Edit
                </button>
            }
        </div>

        <div class="py-2">
            <h4 class="mb-3">@Entity?.Name</h4>
            @if (string.IsNullOrWhiteSpace(ViewText))
            {
                <div class="alert alert-secondary mb-0">Нет содержимого.</div>
            }
            else
            {
                <pre style="white-space: pre-wrap; background:#f8f9fa; padding:12px; border-radius:6px; border:1px solid #e9ecef;">@ViewText</pre>
            }
        </div>
    }
    else
    {
        <div class="py-2">
            <input class="form-control mb-2" placeholder="Заголовок"
                   style="font-size: 1.5rem; font-weight: 500;"
                   @bind="EditTitle" @bind:event="oninput" />

            <textarea class="form-control" rows="16" placeholder="Текст документа"
                      @bind="EditBody" @bind:event="oninput"></textarea>

            <div class="mt-2 d-flex gap-2">
                @if (CanChangePublicFlag)
                {
                    <label class="form-check form-check-inline mb-0 align-self-center">
                        <input class="form-check-input"
                               type="checkbox"
                               checked="@IsPublic"
                               @onchange="HandlePublicChangedAsync"
                               disabled="@IsSaving" />
                        <span class="form-check-label">Общий</span>
                    </label>
                }
                <button class="btn btn-primary" disabled="@IsSaving" @onclick="SaveAsync">
                    @(IsSaving ? "Сохранение..." : "Сохранить")
                </button>
                <button class="btn btn-outline-secondary" disabled="@IsSaving" @onclick="CancelEdit">Отмена</button>
            </div>
        </div>
    }
</div>
