@using BusinessEntity.Components

<div class="rich-text-outline">
    <div class="rich-text-outline__title">Содержание</div>
    <div class="rich-text-outline__controls">
        <select class="form-select form-select-sm rich-text-outline__level-select"
                title="Количество уровней"
                aria-label="Количество уровней содержания"
                value="@DisplayLevelCount"
                @onchange="HandleDisplayLevelCountChangedAsync">
            <option value="1">1 уровень</option>
            <option value="2">2 уровня</option>
            <option value="3">3 уровня</option>
        </select>
        <button type="button"
                class="btn btn-sm btn-outline-secondary rich-text-outline__rebuild"
                disabled="@IsRebuilding"
                @onclick="HandleRebuildRequestedAsync">
            @(IsRebuilding ? "Пересоздание..." : "Пересоздать содержание")
        </button>
    </div>

    @if (Nodes != null && Nodes.Count > 0)
    {
        <div id="@TreeElementId" class="@TreeClass" tabindex="0">
            @foreach (var node in Nodes)
            {
                <RichTextDocumentOutlineItem Node="node" OnHeadingSelected="OnHeadingSelected" />
            }
        </div>
    }
    else if (IsLoading)
    {
        <div class="rich-text-outline__loading">Загрузка содержания...</div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<RichTextDocumentOutlineNode> Nodes { get; set; } = Array.Empty<RichTextDocumentOutlineNode>();
    [Parameter] public string TreeElementId { get; set; } = string.Empty;
    [Parameter] public int DisplayLevelCount { get; set; } = 2;
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsRebuilding { get; set; }
    [Parameter] public bool HideScrollbar { get; set; } = true;
    [Parameter] public EventCallback<RichTextDocumentOutlineNode> OnHeadingSelected { get; set; }
    [Parameter] public EventCallback<int> OnDisplayLevelCountChanged { get; set; }
    [Parameter] public EventCallback OnRebuildRequested { get; set; }

    private string TreeClass =>
        HideScrollbar
            ? "rich-text-outline__tree rich-text-outline__tree--hide-scrollbar"
            : "rich-text-outline__tree";

    private Task HandleDisplayLevelCountChangedAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value))
        {
            value = 2;
        }

        value = Math.Clamp(value, 1, 3);
        return OnDisplayLevelCountChanged.InvokeAsync(value);
    }

    private Task HandleRebuildRequestedAsync()
    {
        return OnRebuildRequested.InvokeAsync();
    }
}
