@using BusinessEntity.Models
@using Radzen
@using Radzen.Blazor

<style>
    .tree-node-selected {
        background-color: #0078d4 !important;
        color: white !important;
        /* Убираем все изменения размеров */
        border-radius: 0;
        padding: 0;
        margin: 0;
        font-weight: inherit; /* Не меняем толщину шрифта */
        border: none;
        outline: none;
    }
    
    .tree-node-dragging {
        opacity: 0.5;
        background-color: #ddd !important;
        color: #666 !important;
        cursor: move;
    }
    
    .tree-node-drag-over {
        background-color: #e3f2fd !important;
        border: 2px dashed #2196f3 !important;
    }
    
    .tree-multiselect-mode .card-header {
        background-color: #e3f2fd;
        border-bottom: 2px solid #2196f3;
    }

    .rz-treeview-item {
        cursor: pointer;
    }

    .rz-treeview-item:hover {
        background-color: #f5f5f5;
    }

    /* Убираем стандартное выделение Radzen */
    .rz-treeview-item.rz-state-highlight {
        background: none !important;
    }
    
    /* Убираем фокус outline */
    .rz-treeview-item:focus {
        outline: none !important;
        box-shadow: none !important;
    }

    /* Контроль размеров для элементов дерева */
    .rz-treeview-item-content {
        padding: 2px 4px;
        margin: 0;
        display: inline-block;
        line-height: normal;
        box-sizing: border-box;
    }

    /* Убираем лишние отступы и обеспечиваем корректную высоту */
    .rz-treeview {
        overflow: visible !important;
        height: auto !important;
        max-height: none !important;
    }

    /* Основной контейнер дерева */
    #main-tree-container {
        overflow: hidden;
    }

    /* Card-body должен показывать скролл только при необходимости */
    #main-tree-container .card-body {
        overflow-y: auto;
        overflow-x: hidden;
        padding: 8px;
    }

    /* Стили для заголовка с кнопкой */
    #main-tree-container .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        padding: 8px 12px;
        font-size: 12px;
    }

    #main-tree-container .card-header .btn {
        font-size: 11px;
        padding: 2px 6px;
        border-radius: 3px;
    }

    /* Стили для режима редактирования */
    .tree-editing-input {
        border: 2px solid #007bff !important;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25) !important;
        background-color: #fff !important;
    }
    
    .tree-editing-input:focus {
        border-color: #007bff !important;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25) !important;
        outline: none !important;
    }
    
    .tree-editing-error {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
    }
</style>

@if (Visible)
{
    <div id="main-tree-container"
         class="card h-100 d-flex flex-column @(IsMultiSelectMode ? "tree-multiselect-mode" : "")"
         style="height: 100%;">
        
        <!-- Панель заголовка скрыта по требованию -->
        
        <div class="card-body flex-grow-1">

            @if (TreeData != null && TreeData.Any())
            {
                <RadzenTree Data="@TreeData"
                            Style="width: 100%; height: 100%;"
                            ItemContextMenu="@OnTreeContextMenu"
                            AllowCheckBoxes="false">
                    <RadzenTreeLevel Text="@GetNodeText"
                                     ChildrenProperty="Children"
                                     HasChildren="@NodeHasChildren"
                                     Expanded="@IsNodeExpanded">
                        <Template Context="item">
                            @{
                                var node = item.Value as TreeNodeItemViewModelBase;
                                var cssClasses = new List<string>();
                                if (node?.IsSelected == true)
                                {
                                    cssClasses.Add("tree-node-selected");
                                }
                                if (node?.IsDragging == true)
                                {
                                    cssClasses.Add("tree-node-dragging");
                                }
                                var cssClass = string.Join(" ", cssClasses);
                                bool isEditing = EditingNode == node;
                            }
                            @if (isEditing)
                            {
                                <input type="text" 
                                       class="form-control form-control-sm tree-editing-input @(HasValidationError ? "tree-editing-error" : "")"
                                       @bind="EditingText" 
                                       @bind:event="oninput"
                                       @onkeydown="OnEditKeyDownAsync"
                                       @onblur="async () => await FinishEditingAsync(true)"
                                       @ref="editingInput"
                                       placeholder="Введите имя папки"
                                       style="display: inline-block; width: auto; min-width: 120px; max-width: 200px;" />
                                @if (HasValidationError)
                                {
                                    <div class="invalid-feedback d-block" style="font-size: 0.75rem; margin-top: 2px;">
                                        @ValidationErrorMessage
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="@cssClass"
                                      draggable="true"
                                      @onclick="async () => await OnNodeClicked(node)"
                                      @onclick:stopPropagation="true"
                                      @onclick:preventDefault="true"
                                      @ondblclick="async () => await OnNodeDoubleClicked(node)"
                                      @ondblclick:stopPropagation="true"
                                      @ondblclick:preventDefault="true"
                                      @ondragstart="async (e) => await OnDragStart(e, node)"
                                      @ondragend="async (e) => await OnDragEnd(e, node)"
                                      @ondragover="async (e) => await OnDragOver(e)"
                                      @ondragover:preventDefault="true"
                                      @ondrop="async (e) => await OnDrop(e, node)"
                                      @ondragenter="(e) => OnDragEnter(e, node)"
                                      @ondragleave="(e) => OnDragLeave(e, node)">
                                    @if (!string.IsNullOrEmpty(node?.Icon))
                                    {
                                        <RadzenIcon Icon="@node.Icon" Style="font-size:16px; margin-right:4px;" />
                                    }
                                    @node?.Title
                                </span>
                            }
                        </Template>
                    </RadzenTreeLevel>
                </RadzenTree>
            }
            else if (IsLoading)
            {
                <div class="alert alert-info mb-0">
                    <small>Дерево загружается...</small>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    <small>В выбранном пространстве нет данных для отображения</small>
                </div>
            }

        </div>
    </div>

    <RadzenContextMenu />
}

