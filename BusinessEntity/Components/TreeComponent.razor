@using BusinessEntity.Models
@using Radzen
@using Radzen.Blazor

<style>
    .tree-node-selected {
        background-color: #0078d4 !important;
        color: white !important;
        /* Убираем все изменения размеров */
        border-radius: 0;
        padding: 0;
        margin: 0;
        font-weight: inherit; /* Не меняем толщину шрифта */
        border: none;
        outline: none;
    }
    
    .tree-node-dragging {
        opacity: 0.5;
        background-color: #ddd !important;
        color: #666 !important;
        cursor: move;
    }
    
    .tree-node-drag-over {
        background-color: #e3f2fd !important;
        border: 2px dashed #2196f3 !important;
    }
    
    .tree-multiselect-mode .card-header {
        background-color: #e3f2fd;
        border-bottom: 2px solid #2196f3;
    }

    .rz-treeview-item {
        cursor: pointer;
    }

    .rz-treeview-item:hover {
        background-color: #f5f5f5;
    }

    /* Убираем стандартное выделение Radzen */
    .rz-treeview-item.rz-state-highlight {
        background: none !important;
    }
    
    /* Убираем фокус outline */
    .rz-treeview-item:focus {
        outline: none !important;
        box-shadow: none !important;
    }

    /* Контроль размеров для элементов дерева */
    .rz-treeview-item-content {
        padding: 2px 4px;
        margin: 0;
        display: inline-block;
        line-height: normal;
        box-sizing: border-box;
    }

    /* Убираем лишние отступы и обеспечиваем корректную высоту */
    .rz-treeview {
        overflow: visible !important;
        height: auto !important;
        max-height: none !important;
    }

    /* Основной контейнер дерева */
    #main-tree-container {
        overflow: hidden;
    }

    /* Card-body должен показывать скролл только при необходимости */
    #main-tree-container .card-body {
        overflow-y: auto;
        overflow-x: hidden;
        padding: 8px;
    }
</style>

@if (Visible)
{
    <div id="main-tree-container" class="card h-100 d-flex flex-column @(IsMultiSelectMode ? "tree-multiselect-mode" : "")" style="height: 100%;">
        <div class="card-body flex-grow-1">
            @if (TreeData != null && TreeData.Any())
            {
                <RadzenTree Data="@TreeData" Style="width: 100%; height: 100%;"
                            ItemContextMenu="@OnTreeContextMenu"
                            Change="@OnTreeNodeClick"
                            AllowCheckBoxes="false">
                    <RadzenTreeLevel Text="@GetNodeText" ChildrenProperty="Children" Expanded="@IsNodeExpanded" 
                                     Template="@TreeNodeTemplate" />
                </RadzenTree>
            }
            else if (IsLoading)
            {
                <div class="alert alert-info mb-0">
                    <small>Дерево загружается...</small>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    <small>В выбранном пространстве нет данных для отображения</small>
                </div>
            }
        </div>
    </div>

    @* Host component for dynamic Radzen context menus *@
    <RadzenContextMenu />
}

@code {
    private RenderFragment<RadzenTreeItem> TreeNodeTemplate => (context) => __builder =>
    {
        var node = context.Value as TreeNodeItemViewModelBase;
        var cssClasses = new List<string>();
        
        if (node?.IsSelected == true)
            cssClasses.Add("tree-node-selected");
            
        if (node?.IsDragging == true)
            cssClasses.Add("tree-node-dragging");
            
        var cssClass = string.Join(" ", cssClasses);
        var component = this; // Ссылка на компонент
        
        <span class="@cssClass" 
              draggable="true"
              @onclick="async () => await component.OnNodeClicked(node)" 
              @onclick:stopPropagation="true" 
              @onclick:preventDefault="true"
              @ondragstart="async (e) => await component.OnDragStart(e, node)"
              @ondragend="async (e) => await component.OnDragEnd(e, node)"
              @ondragover="component.OnDragOver"
              @ondragover:preventDefault="true"
              @ondrop="async (e) => await component.OnDrop(e, node)"
              @ondragenter="(e) => component.OnDragEnter(e, node)"
              @ondragleave="(e) => component.OnDragLeave(e, node)">
            @context.Text
        </span>
    };
}