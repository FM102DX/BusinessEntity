@using BusinessEntity.Models

<div class="card">
    <div class="card-header">
        <h6>Структура бизнес-сущностей</h6>
    </div>
    <div class="card-body p-2">
        @if (TreeData != null && TreeData.Any())
        {
            <RadzenTree Data="@TreeData" Style="width: 100%; height: 400px;">
                <RadzenTreeLevel Text="@GetNodeText" />
            </RadzenTree>
        }
        else if (IsLoading)
        {
            <div class="alert alert-info mb-0">
                <small>Дерево загружается...</small>
            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                <small>Нет данных для отображения</small>
            </div>
        }
    </div>
</div> 