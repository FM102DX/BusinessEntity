@using BusinessEntity.Models
@using Radzen
@using Radzen.Blazor

@if (Visible)
{
    <div class="card h-100 d-flex flex-column" style="height: 100%;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Структура бизнес-сущностей</h6>
        </div>
        <div class="card-body p-2 flex-grow-1" style="overflow-y: auto;">
            @if (TreeData != null && TreeData.Any())
            {
                <RadzenTree Data="@TreeData" Style="width: 100%; height: 100%;">
                    <RadzenTreeLevel Text="@GetNodeText" ChildrenProperty="Children" />
                </RadzenTree>
            }
            else if (IsLoading)
            {
                <div class="alert alert-info mb-0">
                    <small>Дерево загружается...</small>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    <small>В выбранном пространстве нет данных для отображения</small>
                </div>
            }
        </div>
    </div>
}