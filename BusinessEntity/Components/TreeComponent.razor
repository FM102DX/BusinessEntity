@using BusinessEntity.Models
@using Radzen
@using Radzen.Blazor

@if (Visible)
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Структура бизнес-сущностей</h6>
            <div>
                <button class="btn btn-sm btn-outline-primary me-2" @onclick="RefreshTreeAsync" disabled="@IsLoading">
                    <i class="fas fa-sync-alt"></i> Обновить
                </button>
                <button class="btn btn-sm btn-outline-success" @onclick="CreateAdditionalTestDataAndRefreshAsync" disabled="@IsLoading">
                    <i class="fas fa-plus"></i> Тест данные
                </button>
            </div>
        </div>
        <div class="card-body p-2">
            @if (TreeData != null && TreeData.Any())
            {
                <RadzenTree Data="@TreeData" Style="width: 100%; height: 400px;">
                    <RadzenTreeLevel Text="@GetNodeText" ChildrenProperty="Children" />
                </RadzenTree>
            }
            else if (IsLoading)
            {
                <div class="alert alert-info mb-0">
                    <small>Дерево загружается...</small>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    <small>В выбранном пространстве нет данных для отображения</small>
                </div>
            }
        </div>
    </div>
}