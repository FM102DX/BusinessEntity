@using BusinessEntity.Services
@using Microsoft.AspNetCore.Components

<div class="py-2">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="rich-text-document-title">
            <input class="form-control form-control-lg rich-text-document-title__input"
                   value="@EditableEntityName"
                   maxlength="@RichTextDocumentHelper.MaxRichTextDocumentTitleLength"
                   @oninput="HandleTitleInputAsync"
                   aria-label="Название rich-text документа" />
            @if (!string.IsNullOrWhiteSpace(TitleValidationMessage))
            {
                <div class="rich-text-document-title__validation">@TitleValidationMessage</div>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button"
                    class="btn btn-sm btn-outline-secondary rich-text-document-read-mode-button"
                    title="Перейти в режим чтения"
                    aria-label="Перейти в режим чтения"
                    @onclick="HandleReadModeAsync"
                    disabled="@IsSaving">
                <svg class="rich-text-document-read-mode-button__icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true"
                     focusable="false">
                    <path d="M4 5.5c2.8 0 5 .6 7 2.1v11.2c-2-1.4-4.2-2-7-2.1V5.5Z" />
                    <path d="M20 5.5c-2.8 0-5 .6-7 2.1v11.2c2-1.4 4.2-2 7-2.1V5.5Z" />
                    <path d="M11 7.6h2" />
                </svg>
            </button>
            <button type="button"
                    class="btn btn-sm btn-primary"
                    @onclick="HandleSaveAsync"
                    disabled="@IsSaving">
                Save
            </button>
        </div>
    </div>

    @if (IsBusy)
    {
        <div class="alert alert-secondary mb-0">Обработка rich-text документа...</div>
    }
    else
    {
        <div class="rich-text-document-layout">
            <div class="rich-text-document-layout__outline">
                <RichTextDocumentOutline Nodes="VisibleOutlineNodes"
                                         TreeElementId="@OutlineTreeElementId"
                                         DisplayLevelCount="@DisplayLevelCount"
                                         IsLoading="@IsOutlineLoading"
                                         IsRebuilding="@IsRebuildingTableOfContents"
                                         CanRebuild="true"
                                         HideScrollbar="@HideTableOfContentsScrollbar"
                                         OnDisplayLevelCountChanged="HandleDisplayLevelCountChangedAsync"
                                         OnRebuildRequested="HandleRebuildTableOfContentsAsync"
                                         OnHeadingSelected="HandleHeadingSelectedAsync" />
            </div>
            <div class="rich-text-document-layout__content">
                <RichTextDocumentEditorViewport @ref="EditorViewport"
                                                ViewportElementId="@EditorViewportElementId"
                                                BusinessEntityId="@BusinessEntityId"
                                                DocumentVersion="@ViewedVersion"
                                                OutlineNodes="@LocalOutlineNodes"
                                                IsInitialContentLoading="@IsInitialContentLoading"
                                                InitialTargetPosition="@InitialTargetPosition"
                                                InitialWindow="@InitialChunkWindow" />
            </div>
            <div class="rich-text-document-layout__widgets">
                <RichTextDocumentWidgets BusinessEntityId="@BusinessEntityId"
                                         Bookmarks="@Bookmarks"
                                         ActiveBookmarkId="@ActiveBookmarkId"
                                         VersionsRefreshToken="@VersionsRefreshToken"
                                         ViewedVersion="@ViewedVersion"
                                         LatestVersion="@LatestVersion"
                                         OnSearchNext="HandleSearchNextAsync"
                                         OnSearchPrevious="HandleSearchPreviousAsync"
                                         OnCreateBookmark="HandleCreateBookmarkAsync"
                                         OnBookmarkSelected="HandleBookmarkSelectedAsync"
                                         OnBookmarkDeleted="HandleBookmarkDeletedAsync"
                                         OnVersionSelected="HandleVersionSelectedAsync" />
            </div>
        </div>
    }
</div>
