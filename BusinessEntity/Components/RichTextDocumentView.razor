@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using BusinessEntity.Core.RichText

<div class="py-2">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">@EntityName</h4>
        <div class="d-flex align-items-center gap-2">
            <label class="btn btn-sm btn-outline-secondary mb-0">
                Импорт
                <InputFile class="d-none" OnChange="HandleImportSelected" accept=".txt,.md,.markdown,.html,.htm" />
            </label>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="alert alert-info py-2">@StatusMessage</div>
    }

    @if (IsBusy)
    {
        <div class="alert alert-secondary mb-0">Обработка rich-text документа...</div>
    }
    else if (string.IsNullOrWhiteSpace(HtmlContent))
    {
        <div class="alert alert-secondary mb-0">Документ пуст. Импортируйте .txt, .md или .html.</div>
    }
    else
    {
        <div class="rich-text-document-body border rounded p-3 bg-white">
            @((MarkupString)HtmlContent)
        </div>
    }
</div>
