@using BusinessEntity.Core.RichText
@using Microsoft.AspNetCore.Components
@implements IAsyncDisposable

<div id="@ViewportElementId" class="rich-text-document-viewport" data-rich-text-bottom-reserve-px="@BottomReserveAttributeValue" tabindex="0">
    @if (IsInitialContentLoading && LoadedChunks.Count == 0)
    {
        <div class="rich-text-document-viewport__loading">Загрузка текста...</div>
    }

    <div class="rich-text-document-viewport__spacer" style="@TopSpacerStyle"></div>

    @foreach (var chunk in LoadedChunks)
    {
        <article @key="chunk.Id"
                 class="rich-text-document-viewport__chunk"
                 data-rich-text-chunk="true"
                 data-chunk-sort-order="@chunk.SortOrder">
            @((MarkupString)(chunk.HtmlCache ?? string.Empty))
        </article>
    }

    <div class="rich-text-document-viewport__spacer" style="@BottomSpacerStyle"></div>
</div>
