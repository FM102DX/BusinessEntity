@page "/diagnostics"
@using System.Linq
@using global::BusinessEntity.Core.Classes
@inject global::BusinessEntity.Core.Services.BusinessEntityHelper Helper


<PageTitle>Диагностика</PageTitle>

@if (IsLoading)
{
    <div class="alert alert-info">Загрузка...</div>
}
else if (Error != null)
{
    <div class="alert alert-danger">@Error</div>
}
else
{
    <div class="container py-3">
        <h3 class="mb-3">Диагностика сущностей и связей</h3>

        <div class="mb-3">
            <strong>Всего сущностей:</strong> @Entities.Count
            <br />
            <strong>Spaces:</strong> @Spaces.Count
            <br />
            <strong>Folders:</strong> @Folders.Count
            <br />
            <strong>Documents:</strong> @Documents.Count
            <br />
            <strong>Связей всего:</strong> @Relations.Count
        </div>

        <h5 class="mt-4">Сущности по типам</h5>
        <div class="row">
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header">Spaces (@Spaces.Count)</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var e in Spaces)
                        {
                            <li class="list-group-item">
                                <span class="badge bg-secondary me-2">Space</span>
                                @e.Name
                                <small class="text-muted ms-2">@e.Id</small>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header">Folders (@Folders.Count)</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var e in Folders)
                        {
                            <li class="list-group-item">
                                <span class="badge bg-info me-2">Folder</span>
                                @e.Name
                                <small class="text-muted ms-2">@e.Id</small>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header">Documents (@Documents.Count)</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var e in Documents)
                        {
                            <li class="list-group-item">
                                <span class="badge bg-success me-2">Doc</span>
                                @e.Name
                                <small class="text-muted ms-2">@e.Id</small>
                                @if (e.EntityType == BusinessEntityTypeEnum.Document)
                                {
                                    <a class="ms-2" href="/document/@e.Id">Открыть</a>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <h5 class="mt-4">Связи</h5>
        @if (!Relations.Any())
        {
            <div class="alert alert-secondary">Связей нет.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Тип связи</th>
                            <th>От</th>
                            <th></th>
                            <th>К</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Relations)
                        {
                            var from = EntityById.GetValueOrDefault(r.ObjectAId);
                            var to = EntityById.GetValueOrDefault(r.ObjectBId);
                            <tr>
                                <td><span class="badge bg-dark">@r.RelationType</span></td>
                                <td>
                                    @if (from != null)
                                    {
                                        <span class="me-1">@from.Name</span>
                                        <small class="text-muted">(@from.EntityType)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@r.ObjectAId</span>
                                    }
                                </td>
                                <td class="text-center">→</td>
                                <td>
                                    @if (to != null)
                                    {
                                        <span class="me-1">@to.Name</span>
                                        <small class="text-muted">(@to.EntityType)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@r.ObjectBId</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private List<BusinessEntity> Entities = new();
    private List<Relation> Relations = new();

    private List<BusinessEntity> Spaces = new();
    private List<BusinessEntity> Folders = new();
    private List<BusinessEntity> Documents = new();

    private Dictionary<Guid, BusinessEntity> EntityById = new();

    private bool IsLoading = true;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsLoading = true;
            Error = null;

            var allEntities = await Helper.GetAllBusinessEntities();
            var allRelations = await Helper.GetAllRelations();

            Entities = allEntities.OrderBy(e => e.CreatedDate).ToList();
            Relations = allRelations.OrderBy(r => r.RelationType).ToList();

            Spaces = Entities.Where(e => e.EntityType == BusinessEntityTypeEnum.Space).ToList();
            Folders = Entities.Where(e => e.EntityType == BusinessEntityTypeEnum.Folder).ToList();
            Documents = Entities.Where(e => e.EntityType == BusinessEntityTypeEnum.Document).ToList();

            EntityById = Entities.ToDictionary(e => e.Id);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }
}
