@page "/auterlink/loggedout"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@layout BusinessEntity.Shared.MainLayout
@attribute [AllowAnonymous]

<PageTitle>Выход выполнен</PageTitle>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-header">
                    <h3 class="text-center">Выход из KMS Business Entity</h3>
                </div>
                <div class="card-body text-center">
                    <div class="alert alert-success" role="alert">
                        <h4 class="alert-heading">До свидания!</h4>
                        <p>Вы успешно вышли из системы KMS Business Entity.</p>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <a href="/auterlink/login" class="btn btn-primary">Войти снова</a>
                        <a href="/" class="btn btn-outline-secondary">На главную</a>
                    </div>
                    
                    <hr>
                    
                    <div class="text-center">
                        <small class="text-muted">
                            В производственной версии здесь может быть глобальный выход из Auterlink
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>