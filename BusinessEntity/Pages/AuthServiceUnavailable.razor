@page "/auth-service-unavailable"
@layout BusinessEntity.Shared.MainLayout

<PageTitle>Сервис авторизации недоступен</PageTitle>

<div class="auth-error-container">
    <div class="auth-error-content">
        <div class="error-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h1 class="error-title">ОШИБКА: СЕРВИС АВТОРИЗАЦИИ НЕДОСТУПЕН</h1>
        <div class="error-details">
            <p class="error-message">
                Система авторизации Auterlink в настоящий момент недоступна. 
                Невозможно выполнить аутентификацию пользователя.
            </p>
            <div class="error-info">
                <h4>Возможные причины:</h4>
                <ul>
                    <li>Сервис Auterlink временно недоступен</li>
                    <li>Проблемы с сетевым подключением</li>
                    <li>Техническое обслуживание системы</li>
                    <li>Неправильная конфигурация сервиса</li>
                </ul>
            </div>
        </div>
        <div class="error-actions">
            <button class="btn btn-primary" @onclick="RetryConnection">
                <i class="fas fa-redo"></i> Повторить попытку
            </button>
            <button class="btn btn-secondary" @onclick="ContactSupport">
                <i class="fas fa-phone"></i> Связаться с поддержкой
            </button>
        </div>
        <div class="technical-info">
            <p><strong>Время ошибки:</strong> @DateTime.Now.ToString("dd.MM.yyyy HH:mm:ss")</p>
            <p><strong>Код ошибки:</strong> AUTH_SERVICE_UNAVAILABLE</p>
        </div>
    </div>
</div>

<style>
    .auth-error-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 70vh;
        padding: 20px;
    }

    .auth-error-content {
        text-align: center;
        max-width: 600px;
        background-color: #fff;
        border: 1px solid #dc3545;
        border-radius: 10px;
        padding: 40px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .error-icon {
        font-size: 4rem;
        color: #ffc107;
        margin-bottom: 20px;
    }

    .error-title {
        color: #dc3545;
        font-size: 1.8rem;
        font-weight: bold;
        margin-bottom: 30px;
        text-transform: uppercase;
    }

    .error-details {
        margin-bottom: 30px;
        text-align: left;
    }

    .error-message {
        font-size: 1.1rem;
        margin-bottom: 20px;
        color: #495057;
        text-align: center;
    }

    .error-info {
        background-color: #f8f9fa;
        border-left: 4px solid #ffc107;
        padding: 15px;
        margin: 20px 0;
    }

    .error-info h4 {
        color: #495057;
        margin-bottom: 10px;
    }

    .error-info ul {
        margin-bottom: 0;
        padding-left: 20px;
    }

    .error-info li {
        margin-bottom: 5px;
        color: #6c757d;
    }

    .error-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 30px;
    }

    .btn {
        padding: 12px 24px;
        text-decoration: none;
        border-radius: 5px;
        font-weight: 500;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }

    .btn-primary:hover {
        background-color: #0056b3;
        transform: translateY(-2px);
    }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
    }

    .btn-secondary:hover {
        background-color: #545b62;
        transform: translateY(-2px);
    }

    .technical-info {
        background-color: #f1f3f4;
        border-radius: 5px;
        padding: 15px;
        font-size: 0.9rem;
        color: #6c757d;
        text-align: left;
    }

    .technical-info p {
        margin: 5px 0;
    }

    @media (max-width: 768px) {
        .auth-error-content {
            padding: 20px;
        }

        .error-title {
            font-size: 1.4rem;
        }

        .error-actions {
            flex-direction: column;
            align-items: center;
        }

        .btn {
            width: 100%;
            max-width: 250px;
        }
    }
</style>