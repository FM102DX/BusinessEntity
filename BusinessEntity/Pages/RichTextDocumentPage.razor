@page "/rich-document/{id:guid}"

<PageTitle>RichTextDocument</PageTitle>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger">@Error</div>
}
else if (IsLoading)
{
    <div class="alert alert-info">Загрузка rich-text документа...</div>
}
else if (Entity == null)
{
    <div class="alert alert-warning">Документ не найден.</div>
}
else
{
    <div class="py-2 px-2">
        <RichTextDocumentView
            BusinessEntityId="@Id"
            EntityName="@(Entity.Name)"
            InitialChunkWindow="@InitialChunkWindow"
            OutlineNodes="@OutlineNodes"
            IsInitialContentLoading="@IsInitialContentLoading"
            IsOutlineLoading="@IsOutlineLoading"
            IsBusy="@IsImporting"
            IsRebuildingTableOfContents="@IsRebuildingTableOfContents"
            StatusMessage="@StatusMessage"
            OnImportSelected="OnImportSelectedAsync"
            OnRebuildTableOfContents="OnRebuildTableOfContentsAsync"
            OnEditorSaved="OnEditorSavedAsync" />
    </div>
}
