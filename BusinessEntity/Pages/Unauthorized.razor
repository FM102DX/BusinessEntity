@page "/unauthorized"
@layout BusinessEntity.Shared.MainLayout
@attribute [AllowAnonymous]

<PageTitle>Доступ запрещен</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-ban me-2"></i>
                        Доступ запрещен
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger" role="alert">
                        <h4 class="alert-heading">Доступ запрещен</h4>
                        <p>У вас нет доступа к системе KMS Business Entity. Для работы с системой необходимо войти через Auterlink.</p>
                        <hr>
                        <p class="mb-0">Пожалуйста, авторизуйтесь для продолжения работы.</p>
                    </div>
                    
                    <div class="text-center">
                        <a href="/login" class="btn btn-primary me-2">
                            Войти через Auterlink
                        </a>
                        <a href="/" class="btn btn-outline-secondary">
                            На главную
                        </a>
                    </div>
                    
                    <div class="mt-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6>Информация:</h6>
                                <small class="text-muted">
                                    <strong>Время:</strong> @DateTime.Now.ToString("dd.MM.yyyy HH:mm:ss")<br>
                                    <strong>Статус:</strong> Пользователь не авторизован<br>
                                    <strong>Приложение:</strong> KMS Business Entity
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>