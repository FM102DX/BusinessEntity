@page "/business-entity-test"
@using BusinessEntity.Core.Classes
@using BusinessEntityClass = BusinessEntity.Core.Classes.BusinessEntity

<PageTitle>Business Entity Test</PageTitle>

<h3>Business Entity Helper Test</h3>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Create Business Entity</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Name:</label>
                    <input @bind="newEntityName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Type:</label>
                    <select @bind="selectedEntityType" class="form-select">
                        <option value="@BusinessEntityTypeEnum.Space">Space</option>
                        <option value="@BusinessEntityTypeEnum.Folder">Folder</option>
                        <option value="@BusinessEntityTypeEnum.Page">Page</option>
                    </select>
                </div>
                <button @onclick="CreateEntity" class="btn btn-primary">Create Entity</button>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5>Create Relation</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Entity A:</label>
                    <select @bind="selectedEntityAId" class="form-select">
                        <option value="">Select Entity A</option>
                        @foreach (var entity in entities)
                        {
                            <option value="@entity.Id">@entity.Name (@entity.EntityType)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Entity B:</label>
                    <select @bind="selectedEntityBId" class="form-select">
                        <option value="">Select Entity B</option>
                        @foreach (var entity in entities)
                        {
                            <option value="@entity.Id">@entity.Name (@entity.EntityType)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Relation Type:</label>
                    <select @bind="selectedRelationType" class="form-select">
                        <option value="">Select Relation Type</option>
                        @foreach (var relationType in relationTypes)
                        {
                            <option value="@relationType.RelationName">@relationType.RelationName</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Parameters:</label>
                    <input @bind="relationParameters" class="form-control" />
                </div>
                <button @onclick="CreateRelation" class="btn btn-success">Create Relation</button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Business Entities (@entities.Count)</h5>
                <button @onclick="LoadEntities" class="btn btn-sm btn-outline-primary">Refresh</button>
            </div>
            <div class="card-body">
                @if (entities.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entity in entities)
                                {
                                    <tr>
                                        <td>@entity.Name</td>
                                        <td>@entity.EntityType</td>
                                        <td>@entity.CreatedDate.ToString("HH:mm:ss")</td>
                                        <td>
                                            <button @onclick="() => DeleteEntity(entity.Id)" class="btn btn-sm btn-danger">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No entities created yet.</p>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5>Relations (@relations.Count)</h5>
            </div>
            <div class="card-body">
                @if (relations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Entity A</th>
                                    <th>Entity B</th>
                                    <th>Type</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var relation in relations)
                                {
                                    <tr>
                                        <td>@GetEntityName(relation.ObjectAId)</td>
                                        <td>@GetEntityName(relation.ObjectBId)</td>
                                        <td>@relation.RelationType</td>
                                        <td>@relation.CreatedDate.ToString("HH:mm:ss")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No relations created yet.</p>
                }
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info mt-3">
        @message
    </div>
} 