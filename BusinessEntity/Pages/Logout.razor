@page "/logout"
@layout BusinessEntity.Shared.MainLayout
@attribute [AllowAnonymous]

<PageTitle>Выход из системы</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="text-center">Выход из системы</h3>
                </div>
                <div class="card-body text-center">
                    <div class="alert alert-success">
                        <h4>До свидания!</h4>
                        <p>Вы успешно вышли из системы KMS Business Entity.</p>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <a href="/login" class="btn btn-primary">Войти снова</a>
                        <a href="/" class="btn btn-outline-secondary">На главную</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>