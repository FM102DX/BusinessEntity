@page "/logout"
@layout BusinessEntity.Shared.MainLayout

<PageTitle>Выход из системы</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-check-circle me-2"></i>
                        Выход выполнен успешно
                    </h3>
                </div>
                <div class="card-body text-center">
                    <div class="alert alert-success" role="alert">
                        <h4 class="alert-heading">До свидания!</h4>
                        <p>Вы успешно вышли из системы KMS Business Entity.</p>
                        <hr>
                        <p class="mb-0">Ваша сессия завершена, и все данные аутентификации удалены.</p>
                    </div>
                    
                    <div class="mt-4">
                        <a href="/" class="btn btn-primary me-2">
                            <i class="fas fa-home me-1"></i>
                            На главную страницу
                        </a>
                        <a href="/auterlink/login" class="btn btn-outline-secondary">
                            <i class="fas fa-sign-in-alt me-1"></i>
                            Войти снова
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>