@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@attribute [AllowAnonymous]

<PageTitle>KMS-Business-Entities-Main</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="auth-summary-container">
            @if (!string.IsNullOrEmpty(CurrentUserName))
            {
                <div class="alert alert-success d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@CurrentUserName</strong>
                        @if (!string.IsNullOrEmpty(CurrentUserId))
                        {
                            <small class="text-muted">(@CurrentUserId)</small>
                        }
                    </div>
                    <div>
                        <a href="/authinfo" class="btn btn-outline-primary btn-sm me-2">Подробнее об авторизации</a>
                    </div>
                </div>
            }
        </div>

        <h1>KMS Business Entity</h1>

        <div class="main-content">
            <div class="alert alert-success">
                <h4>Система управления бизнес-сущностями</h4>
                <p>Добро пожаловать в систему управления бизнес-сущностями KMS. Вы успешно авторизованы через Authentic.</p>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5>Быстрые действия</h5>
                        </div>
                        <div class="card-body">
                            <p>Здесь будут располагаться основные функции системы управления бизнес-сущностями.</p>
                            <button class="btn btn-primary" disabled>Создать сущность</button>
                            <button class="btn btn-secondary ms-2" disabled>Просмотр каталога</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5>Информация</h5>
                        </div>
                        <div class="card-body">
                            <p>Для просмотра детальной информации об авторизации перейдите в раздел "Авторизация".</p>
                            <a href="/authinfo" class="btn btn-info">Информация об авторизации</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <h1>KMS Business Entity</h1>
                    <div class="alert alert-warning">
                        <h4>Требуется авторизация</h4>
                        <p>Для доступа к системе KMS Business Entity необходимо войти в систему через Authentic.</p>
                        <button class="btn btn-primary" @onclick="RedirectToLogin">Войти через Authentic</button>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .auth-summary-container {
        margin-bottom: 20px;
    }

    .main-content {
        margin-top: 20px;
    }

    .card {
        margin-bottom: 20px;
    }

    .btn-sm {
        font-size: 0.875rem;
    }
</style>