@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@attribute [AllowAnonymous]

<PageTitle>KMS-Business-Entities-Main</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>KMS Business Entity</h1>
        
        <div class="user-info-container">
            @if (!string.IsNullOrEmpty(CurrentUserName))
            {
                <div class="alert alert-info d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Пользователь:</strong> @CurrentUserName
                        @if (!string.IsNullOrEmpty(CurrentUserId))
                        {
                            <small class="text-muted ms-2">ID: @CurrentUserId</small>
                        }
                    </div>
                    <div>
                        <a href="/authinfo" class="btn btn-outline-primary btn-sm">Подробнее об авторизации</a>
                    </div>
                </div>
            }
        </div>

        <div class="main-content">
            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5>Доступные типы сущностей</h5>
                        </div>
                        <div class="card-body">
                            <p>В системе доступны следующие типы бизнес-сущностей:</p>
                            @if (BusinessEntityTypes != null && BusinessEntityTypes.Any())
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var entityType in BusinessEntityTypes)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span class="badge bg-primary rounded-pill">@entityType</span>
                                            <small class="text-muted">Тип сущности</small>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="alert alert-info mb-0">
                                    <small>Типы сущностей загружаются...</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <h1>KMS Business Entity</h1>
                    <div class="alert alert-warning">
                        <h4>Требуется авторизация</h4>
                        <p>Для доступа к системе KMS Business Entity необходимо войти в систему через Authentic.</p>
                        <button class="btn btn-primary" @onclick="RedirectToLogin">Войти через Authentic</button>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .user-info-container {
        margin-bottom: 20px;
    }

    .main-content {
        margin-top: 20px;
    }

    .card {
        margin-bottom: 20px;
    }

    .btn-sm {
        font-size: 0.875rem;
    }

    .lead {
        margin-bottom: 30px;
        text-align: center;
        color: #6c757d;
    }
</style>