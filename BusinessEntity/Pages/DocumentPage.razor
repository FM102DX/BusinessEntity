@page "/document/{id:guid}"
@using System.Linq
@using global::BusinessEntity.Core.Classes

<PageTitle>Document</PageTitle>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger">@Error</div>
}
else if (IsLoading)
{
    <div class="alert alert-info">Загрузка документа...</div>
}
else if (Entity == null)
{
    <div class="alert alert-warning">Документ не найден.</div>
}
else
{
    <div class="container py-3">
        <h4 class="mb-3">@Entity.Name</h4>
        @if (string.IsNullOrWhiteSpace(DataText))
        {
            <div class="alert alert-secondary">Нет содержимого.</div>
        }
        else
        {
            <pre style="white-space: pre-wrap; background:#f8f9fa; padding:12px; border-radius:6px; border:1px solid #e9ecef;">@DataText</pre>
        }
    </div>
}


