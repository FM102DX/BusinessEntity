@page "/administration"
@using Microsoft.Extensions.Configuration
@using BusinessEntity.MiniApps.DataProviderMiniApp.Contracts.Connectors
@using BusinessEntity.MiniApps.SampleDataMiniApp.Contracts
@inject IConfiguration Configuration
@inject IDataProviderConnector DataProviderConnector
@inject ISampleDataMiniApp SampleDataMiniApp

<PageTitle>Администрирование</PageTitle>

<div class="container py-3">
    <h3 class="mb-3">Администрирование</h3>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "general" ? "active" : null)"
                    @onclick='() => SelectTab("general")'>
                Общее
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "spaces" ? "active" : null)"
                    @onclick='() => SelectTab("spaces")'>
                Пространства
            </button>
        </li>
    </ul>

    @if (ActiveTab == "general")
    {
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Пользователи Authentik</h5>
                <p class="card-text">
                    Управление пользователями, их паролями, группами и ролями выполняется в административном интерфейсе Authentik.
                </p>
                <p class="card-text">
                    После открытия страницы перейдите в меню <strong>Directory -> Users</strong>.
                </p>
                <a class="btn btn-primary"
                   href="@AuthentikAdminUrl"
                   target="_blank"
                   rel="noopener noreferrer">
                    Открыть управление пользователями в Authentik
                </a>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">Debug Re-seed</h5>
                <p class="card-text">
                    Временно для отладки: полностью очищает BusinessEntity-хранилище и запускает seed заново.
                </p>
                <button class="btn btn-danger"
                        @onclick="ReSeedAsync"
                        disabled="@IsReseeding">
                    @(IsReseeding ? "Re-seed..." : "Re-seed")
                </button>

                @if (!string.IsNullOrWhiteSpace(ReSeedStatus))
                {
                    <div class="mt-2 text-muted">@ReSeedStatus</div>
                }

                @if (!string.IsNullOrWhiteSpace(ReSeedError))
                {
                    <div class="mt-2 text-danger">@ReSeedError</div>
                }
            </div>
        </div>
    }
    else if (ActiveTab == "spaces")
    {
        <SpacesAdministration />
    }
</div>

@code {
    private string ActiveTab { get; set; } = "general";
    private bool IsReseeding;
    private string? ReSeedStatus;
    private string? ReSeedError;

    private string AuthentikAdminUrl =>
        (
            Environment.GetEnvironmentVariable("AUTHENTIK_BASE_URL_FOR_BROWSER")
            ?? Configuration["AuthentikAuth:BaseUrlForBrowser"]
            ?? Configuration["AuthentikAuth:BaseUrl"]
            ?? "http://localhost:9000"
        ).TrimEnd('/') + "/if/admin/";

    private void SelectTab(string tabName)
    {
        ActiveTab = tabName;
    }

    private async Task ReSeedAsync()
    {
        try
        {
            IsReseeding = true;
            ReSeedError = null;
            ReSeedStatus = "Очищаем хранилище и запускаем seed заново...";
            await DataProviderConnector.ClearAllAsync();
            await SampleDataMiniApp.ForceReseedAsync();
            ReSeedStatus = "Re-seed завершен.";
        }
        catch (Exception ex)
        {
            ReSeedError = ex.Message;
        }
        finally
        {
            IsReseeding = false;
        }
    }
}
