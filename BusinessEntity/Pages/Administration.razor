@page "/administration"
@using BusinessEntity.MiniApps.UserMiniApp.Components
<PageTitle>Администрирование</PageTitle>

<div class="container py-3">
    <h3 class="mb-3">Администрирование</h3>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "general" ? "active" : null)"
                    @onclick='() => SelectTab("general")'>
                Общее
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "sys-parameters" ? "active" : null)"
                    @onclick='() => SelectTab("sys-parameters")'>
                Параметры системы
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "spaces" ? "active" : null)"
                    @onclick='() => SelectTab("spaces")'>
                Пространства
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "users" ? "active" : null)"
                    @onclick='() => SelectTab("users")'>
                Пользователи
            </button>
        </li>
    </ul>

    @if (ActiveTab == "general")
    {
        <GeneralAdministration />
    }
    else if (ActiveTab == "sys-parameters")
    {
        <SysParametersAdministration />
    }
    else if (ActiveTab == "spaces")
    {
        <SpacesAdministration />
    }
    else if (ActiveTab == "users")
    {
        <UsersAdministration />
    }
</div>

@code {
    private string ActiveTab { get; set; } = "general";

    private void SelectTab(string tabName)
    {
        ActiveTab = tabName;
    }
}
