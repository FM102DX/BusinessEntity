@using BusinessEntity.Core.Classes
@using BusinessEntity.Core.DomainEntities
@using BusinessEntity.Core.Services
@using BusinessEntity.Contracts
@using BusinessEntity.MiniApps.UserMiniApp.Contracts.Connectors
@using BusinessEntity.MiniApps.UserMiniApp.Contracts.Dtos
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@implements IDisposable
@inject IUserContextService UserContext
@inject BusinessEntityHelper BusinessEntityHelper
@inject SpaceHelper SpaceHelper
@inject IUserConnector UserConnector
@inject NavigationManager Navigation

<div class="app-header">
    @if (!string.IsNullOrWhiteSpace(CompanyName))
    {
        <div class="app-header__company">@CompanyName</div>
    }

    <div class="app-header__actions">
        @if (IsAuthenticated)
        {
            <div class="app-header__user-menu"
                 @onmouseenter="CancelUserMenuAutoClose"
                 @onmouseleave="ScheduleUserMenuAutoClose">
                <button type="button"
                        class="app-header__avatar"
                        title="@UserName"
                        aria-expanded="@IsUserMenuOpen"
                        @onclick="ToggleUserMenu">
                    @UserInitials
                </button>

                @if (IsUserMenuOpen)
                {
                    <div class="app-header__dropdown">
                        <a class="app-header__dropdown-item" href="/profile">Профиль</a>
                        <div class="app-header__dropdown-separator" aria-hidden="true"></div>
                        <div class="app-header__dropdown-submenu">
                            <button type="button"
                                    class="app-header__dropdown-item app-header__dropdown-submenu-trigger"
                                    aria-haspopup="true">
                                <span>Пространства</span>
                                <span class="app-header__dropdown-submenu-arrow" aria-hidden="true">‹</span>
                            </button>
                            <div class="app-header__submenu">
                                <a class="app-header__submenu-item app-header__submenu-item--all"
                                   href="/space-selection"
                                   @onclick="CloseUserMenu">
                                    Все пространства
                                </a>
                                <div class="app-header__submenu-separator" aria-hidden="true"></div>
                                @if (Spaces.Count == 0)
                                {
                                    <div class="app-header__submenu-empty">Нет пространств</div>
                                }
                                else
                                {
                                    @foreach (var space in Spaces)
                                    {
                                        <button type="button"
                                                class="@GetSpaceMenuItemClass(space.Id)"
                                                title="@space.Name"
                                                @onclick="() => SelectSpace(space.Id)">
                                            @space.Name
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                        <div class="app-header__dropdown-separator" aria-hidden="true"></div>
                        <a class="app-header__dropdown-item" href="/auth/logout">Выход</a>
                    </div>
                }
            </div>
        }
        else
        {
            @if (ShowAnonymousSpacesLink)
            {
                <a class="app-header__link-button" href="/space-selection">Пространства</a>
            }
            <a class="app-header__login" href="@LoginFormUrl">Войти</a>
        }
    </div>
</div>

@code {
    private string CompanyName { get; set; } = string.Empty;
    private bool IsAuthenticated { get; set; }
    private string UserName { get; set; } = string.Empty;
    private string UserInitials { get; set; } = string.Empty;
    private bool IsUserMenuOpen { get; set; }
    private IReadOnlyList<HeaderSpaceItem> Spaces { get; set; } = Array.Empty<HeaderSpaceItem>();
    private IReadOnlyList<UserSpaceRecord> AnonymousAccessibleSpaces { get; set; } = Array.Empty<UserSpaceRecord>();
    private bool ShowAnonymousSpacesLink => !IsAuthenticated && AnonymousAccessibleSpaces.Count > 1;
    private string LoginFormUrl => $"/login?returnUrl={Uri.EscapeDataString(BuildCurrentReturnUrl())}";
    private CancellationTokenSource? _userMenuAutoCloseCts;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var sysParametersEntity = await BusinessEntityHelper.GetOrCreateSingletonEntityAsync<SysParameters>(
                BusinessEntityTypeEnum.SysParametersTp,
                "SysParameters");

            CompanyName = sysParametersEntity.Data.CompanyName?.Trim() ?? string.Empty;
        }
        catch
        {
            CompanyName = string.Empty;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationStateTask == null)
        {
            IsAuthenticated = false;
            UserName = string.Empty;
            UserInitials = string.Empty;
            Spaces = Array.Empty<HeaderSpaceItem>();
            return;
        }

        var authState = await AuthenticationStateTask;
        var user = authState.User;

        IsAuthenticated = user.Identity?.IsAuthenticated == true;
        if (!IsAuthenticated)
        {
            UserName = string.Empty;
            UserInitials = string.Empty;
            IsUserMenuOpen = false;
            Spaces = Array.Empty<HeaderSpaceItem>();
            AnonymousAccessibleSpaces = await UserConnector.GetAnonymousAccessibleSpacesAsync();
            return;
        }

        AnonymousAccessibleSpaces = Array.Empty<UserSpaceRecord>();
        UserName =
            user.Identity?.Name
            ?? user.FindFirst("preferred_username")?.Value
            ?? user.FindFirst(ClaimTypes.Name)?.Value
            ?? string.Empty;

        UserInitials = BuildInitials(UserName);
        Spaces = await LoadSpacesAsync();
    }

    private static string BuildInitials(string userName)
    {
        if (string.IsNullOrWhiteSpace(userName))
        {
            return string.Empty;
        }

        var trimmed = userName.Trim();
        return trimmed.Length >= 2
            ? trimmed[..2].ToUpperInvariant()
            : trimmed.ToUpperInvariant();
    }

    // Возвращает локальный адрес, куда пользователь должен попасть после входа.
    private string BuildCurrentReturnUrl()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relativePath)
            ? "/"
            : "/" + relativePath;

        if (returnUrl.StartsWith("/auth", StringComparison.OrdinalIgnoreCase) ||
            returnUrl.StartsWith("/login", StringComparison.OrdinalIgnoreCase))
        {
            return "/";
        }

        return returnUrl.StartsWith("//", StringComparison.Ordinal) ? "/" : returnUrl;
    }

    private void ToggleUserMenu()
    {
        if (IsUserMenuOpen)
        {
            CloseUserMenu();
            return;
        }

        CancelUserMenuAutoClose();
        IsUserMenuOpen = true;
    }

    private void CloseUserMenu()
    {
        CancelUserMenuAutoClose();
        IsUserMenuOpen = false;
    }

    private void CancelUserMenuAutoClose()
    {
        _userMenuAutoCloseCts?.Cancel();
        _userMenuAutoCloseCts?.Dispose();
        _userMenuAutoCloseCts = null;
    }

    private void ScheduleUserMenuAutoClose()
    {
        if (!IsUserMenuOpen)
        {
            return;
        }

        CancelUserMenuAutoClose();
        var cts = new CancellationTokenSource();
        _userMenuAutoCloseCts = cts;
        _ = CloseUserMenuAfterDelayAsync(cts.Token);
    }

    private async Task CloseUserMenuAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
            if (!cancellationToken.IsCancellationRequested)
            {
                await InvokeAsync(() =>
                {
                    IsUserMenuOpen = false;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose()
    {
        CancelUserMenuAutoClose();
    }

    private async Task<IReadOnlyList<HeaderSpaceItem>> LoadSpacesAsync()
    {
        try
        {
            var spaces = await SpaceHelper.GetSpacesAsync();
            return spaces
                .OrderBy(space => space.Name, StringComparer.OrdinalIgnoreCase)
                .Select(space => new HeaderSpaceItem(space.Id, space.Name))
                .ToList();
        }
        catch
        {
            return Array.Empty<HeaderSpaceItem>();
        }
    }

    private void SelectSpace(Guid spaceId)
    {
        CloseUserMenu();
        Navigation.NavigateTo(GetSpaceSelectUrl(spaceId), forceLoad: true);
    }

    private static string GetSpaceSelectUrl(Guid spaceId)
    {
        return $"/api/space/select/{spaceId}";
    }

    private string GetSpaceMenuItemClass(Guid spaceId)
    {
        return UserContext.CurrentSpaceId == spaceId
            ? "app-header__submenu-item app-header__submenu-item--current"
            : "app-header__submenu-item";
    }

    private sealed record HeaderSpaceItem(Guid Id, string Name);
}
