@inherits LayoutComponentBase
@inject BusinessEntity.Contracts.IUserContextService UserContext

<PageTitle>Business Entity Engine</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <div class="tree-panel">
        <div class="tree-header">
            <h6>Главное дерево системы</h6>
        </div>
        <div class="tree-content">
            <TreeComponent />
        </div>
    </div>

    <main>
        <div class="top-row px-4">
            @if (UserContext.HasSelectedSpace)
            {
                <span>Текущее пространство: @UserContext.CurrentSpaceName</span>
            }
            <a class="ms-3" href="/space-selection">Выбрать пространство</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
