@inject NavigationManager Navigation

<PageTitle>Требуется вход</PageTitle>

<div class="auth-gate">
    <section class="auth-gate__panel" aria-label="Вход в систему">
        <div class="auth-gate__brand">Business Entity</div>
        @if (IsCheckingSession)
        {
            <h1>Проверяем сессию</h1>
            <p>Пожалуйста, подождите.</p>
        }
        else
        {
            <h1>Требуется вход</h1>
            <p>Для доступа к системе войдите через Authentik.</p>
            <a class="auth-gate__button" href="@LoginUrl">Войти через Authentik</a>
        }
    </section>
</div>

@code {
    [Parameter] public bool IsCheckingSession { get; set; }

    private string LoginUrl
    {
        get
        {
            var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
            var returnUrl = string.IsNullOrWhiteSpace(relativePath)
                ? "/"
                : "/" + relativePath;

            if (returnUrl.StartsWith("/auth", StringComparison.OrdinalIgnoreCase))
            {
                returnUrl = "/";
            }

            return $"/auth/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
        }
    }
}

<style>
    .auth-gate {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f3f6f9;
        padding: 24px;
    }

    .auth-gate__panel {
        width: min(440px, 100%);
        border: 1px solid #d4dce8;
        border-radius: 6px;
        background: #fff;
        padding: 28px 30px;
        box-shadow: 0 16px 40px rgba(29, 43, 68, 0.12);
    }

    .auth-gate__brand {
        color: #4f6687;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    .auth-gate h1 {
        margin: 0 0 12px;
        font-size: 28px;
        font-weight: 500;
        line-height: 1.2;
        color: #122033;
    }

    .auth-gate p {
        margin: 0 0 24px;
        color: #44546a;
        line-height: 1.5;
    }

    .auth-gate__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: 0 16px;
        border: 1px solid #0d6efd;
        border-radius: 4px;
        background: #0d6efd;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
    }

    .auth-gate__button:hover,
    .auth-gate__button:focus {
        background: #0b5ed7;
        border-color: #0a58ca;
        color: #fff;
        text-decoration: none;
    }
</style>
