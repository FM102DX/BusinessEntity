@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<PageTitle>Требуется вход</PageTitle>

<div class="auth-gate">
    <section class="auth-gate__panel" aria-label="Вход в систему">
        <div class="auth-gate__brand">Business Entity</div>
        @if (IsCheckingSession)
        {
            <h1>Проверяем сессию</h1>
            <p>Пожалуйста, подождите.</p>
        }
        else
        {
            <h1>Требуется вход</h1>
            <p>Введите логин и пароль Authentik для доступа к системе.</p>

            @if (HasLoginError)
            {
                <div class="auth-gate__error" role="alert">
                    Не удалось войти. Проверьте логин и пароль.
                </div>
            }

            <form class="auth-gate__form" method="post" action="/auth/password-login">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <div class="auth-gate__field">
                    <label for="auth-login">Логин</label>
                    <input id="auth-login"
                           name="username"
                           type="text"
                           autocomplete="username"
                           required
                           autofocus />
                </div>

                <div class="auth-gate__field">
                    <label for="auth-password">Пароль</label>
                    <input id="auth-password"
                           name="password"
                           type="password"
                           autocomplete="current-password"
                           required />
                </div>

                <div class="auth-gate__actions">
                    <button class="auth-gate__submit" type="submit">Логин</button>
                    <a class="auth-gate__fallback" href="@LoginUrl">Через страницу Authentik</a>
                </div>
            </form>
        }
    </section>
</div>

@code {
    [Parameter] public bool IsCheckingSession { get; set; }

    private string ReturnUrl => RemoveLoginError(NormalizeReturnUrl());

    private bool HasLoginError
    {
        get
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            return QueryHelpers.ParseQuery(uri.Query).ContainsKey("loginError");
        }
    }

    private string LoginUrl
    {
        get
        {
            return $"/auth/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
        }
    }

    private string NormalizeReturnUrl()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relativePath)
            ? "/"
            : "/" + relativePath;

        if (returnUrl.StartsWith("/auth", StringComparison.OrdinalIgnoreCase))
        {
            returnUrl = "/";
        }

        return returnUrl;
    }

    private static string RemoveLoginError(string returnUrl)
    {
        var queryStart = returnUrl.IndexOf('?', StringComparison.Ordinal);
        if (queryStart < 0)
        {
            return returnUrl;
        }

        var path = returnUrl[..queryStart];
        var queryText = returnUrl[(queryStart + 1)..];
        var parsedQuery = QueryHelpers.ParseQuery(queryText);
        var cleanedQuery = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);

        foreach (var parameter in parsedQuery)
        {
            if (string.Equals(parameter.Key, "loginError", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            cleanedQuery[parameter.Key] = parameter.Value.ToString();
        }

        return cleanedQuery.Count == 0
            ? path
            : QueryHelpers.AddQueryString(path, cleanedQuery);
    }
}

<style>
