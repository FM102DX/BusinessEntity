@* Persistent right sidebar for settings/widgets *@
@using BusinessEntity.Services
@using BusinessEntity.Models
@using global::BusinessEntity.Core.Classes
@using System.Timers
@using System.Globalization

@inject ITreeSelectionService TreeSelection
@inject RichTextDocumentMessagePanelService RichTextMessages
@implements IDisposable

<div class="right-panel">
    <div class="right-header">
        <h6>Панель настроек и виджетов</h6>
    </div>
    <div class="right-content">
        <div class="widget widget-datetime">
            <div class="widget-title">Дата и время</div>
            <div class="widget-body">@NowString</div>
        </div>

        @if (RichTextMessages.Messages.Count > 0)
        {
            <div class="widget widget-rich-text-messages">
                <div class="widget-title">Сообщения</div>
                <div class="widget-body widget-rich-text-messages__body">
                    @foreach (var message in RichTextMessages.Messages)
                    {
                        <div class="widget-rich-text-messages__item">
                            <div class="widget-rich-text-messages__text">@message.Text</div>
                            <div class="widget-rich-text-messages__time">@message.CreatedAt.ToString("HH:mm:ss")</div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (IsMultiSelected)
        {
            <div class="widget">
                <div class="widget-title">Выбрано несколько элементов</div>
                <div class="widget-body">@TreeSelection.GetSelectedNodesInfo()</div>
            </div>
        }
        else if (Selected is null)
        {
            <div class="widget">
                <div class="widget-title">Информация</div>
                <div class="widget-body">Ничего не выбрано</div>
            </div>
        }
        else
        {
            @* Переключение по типу отображаемой сущности *@
            @switch (Selected.EntityType)
            {
                case "Document":
                    <div class="widget">
                        <div class="widget-title">Документ: @Selected.Title</div>
                        <div class="widget-body">
                            <div>Создан: @FormatDate(Selected.Entity?.CreatedDate)</div>
                            <div>Изменён: @FormatDate(Selected.Entity?.LastModifiedDate)</div>
                        </div>
                    </div>
                    break;
                case "Folder":
                    <div class="widget">
                        <div class="widget-title">Папка: @Selected.Title</div>
                        <div class="widget-body">
                            <div>Элементов: @(Selected.Children?.Count ?? 0)</div>
                        </div>
                    </div>
                    break;
                case "Space":
                    <div class="widget">
                        <div class="widget-title">Пространство: @Selected.Title</div>
                    </div>
                    break;
                default:
                    <div class="widget">
                        <div class="widget-title">Элемент: @Selected.Title</div>
                    </div>
                    break;
            }
        }
    </div>
</div>

@code {
    private TreeNodeItemViewModelBase? Selected => TreeSelection.SingleSelectedNode;
    private bool IsMultiSelected => TreeSelection.IsMultiSelectActive;
    private Timer? _timer;
    private DateTime _now = DateTime.Now;
    private string NowString => _now.ToString("f", CultureInfo.CurrentCulture);

    protected override void OnInitialized()
    {
        TreeSelection.SelectionChanged += OnSelectionChanged;
        RichTextMessages.Changed += OnRichTextMessagesChanged;
        _timer = new Timer(1000);
        _timer.Elapsed += OnTimerElapsed;
        _timer.AutoReset = true;
        _timer.Start();
    }

    private void OnSelectionChanged(List<TreeNodeItemViewModelBase> _)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TreeSelection.SelectionChanged -= OnSelectionChanged;
        RichTextMessages.Changed -= OnRichTextMessagesChanged;
        if (_timer is not null)
        {
            _timer.Stop();
            _timer.Elapsed -= OnTimerElapsed;
            _timer.Dispose();
        }
    }

    private string FormatDate(DateTime? dt)
    {
        return dt.HasValue ? dt.Value.ToLocalTime().ToString("g") : "—";
    }

    private void OnTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        _now = DateTime.Now;
        InvokeAsync(StateHasChanged);
    }

    private void OnRichTextMessagesChanged()
    {
        InvokeAsync(StateHasChanged);
    }
}
