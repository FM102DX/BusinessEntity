@{
    ViewData["Title"] = "Выход выполнен";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/app.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card mt-5">
                    <div class="card-header">
                        <h3 class="text-center">Выход выполнен</h3>
                    </div>
                    <div class="card-body text-center">
                        <div class="alert alert-success" role="alert">
                            <h4 class="alert-heading">До свидания!</h4>
                            <p>Вы успешно вышли из системы.</p>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <a href="/auterlink/login" class="btn btn-primary">Войти снова</a>
                            <a href="/" class="btn btn-outline-secondary">На главную</a>
                        </div>
                        
                        <hr>
                        
                        <div class="text-center">
                            <small class="text-muted">
                                В производственной версии здесь может быть глобальный выход из Auterlink
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>