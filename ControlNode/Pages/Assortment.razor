@page "/assortment"
@using SampleOnlineMall.Core

<h3>Assortment</h3>

<RadzenButton Text="Узнать количество позиций ассортимента" Click="OnLoadAssortClick" Style="margin: 10px;" />
<p>@Message</p>
<RadzenButton Text="Загрузить ассортимент" Click="OnLoadAssortClick" Style="margin: 10px;" />
<p>@Message</p>
<p>@AssortLoader.LastFeedPosCount</p>
<p>Content</p>

<div class="assort-table">
    <div class="assort-table-top-menu">
        <div class="assort-table-top-menu-item">
            <RadzenButton Text="Загрузить ассортимент 2" Click="@AssortLoader.GetAsync" Style="margin: 10px;" />
            <RadzenButton Text="Очистить ассортимент" Click="@AssortLoader.ClearAsync" Style="margin: 10px;" />
        </div>
        <div class="assort-table-top-menu-item">
            <p>@AssortLoader.LoadedPosCount</p>
        </div>
    </div>
    <div class="assort-table">
        <RadzenDataGrid Data="@AssortLoader.Assortment.Items" TItem="CommodityItemApiFeed" >
            <Columns>
                <RadzenDataGridColumn TItem="CommodityItemApiFeed" Title="Image">
                    <Template Context="item">
                        <img src="@($"{item.FirstPic}")" alt="Image" style="width: 100px; height: auto;"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CommodityItemApiFeed" Property="Id" Title="Id" />
                <RadzenDataGridColumn TItem="CommodityItemApiFeed" Property="Name" Title="Name" />
                <RadzenDataGridColumn TItem="CommodityItemApiFeed" Property="Price" Title="Price" />
            </Columns>
        </RadzenDataGrid>
    </div>
</div>



