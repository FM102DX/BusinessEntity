@page "/"
@using Radzen
@using Radzen.Blazor
@using SampleOnlineMall.WebLogger.Models

<PageTitle>LoggerMain</PageTitle>

<h1>LoggerMain</h1>

<p>Общее количество записей: @TotalLogsCount</p>

<RadzenDataGrid TItem="LogEntryDbStorable" ColumnWidth="200px" Count="@TotalLogsCount" Data="@LogEntries"  PagerVisible="true" >
    <Columns>
        <RadzenDataGridColumn TItem="LogEntryDbStorable" Property="Timestamp" Title="Дата и время" />
        <RadzenDataGridColumn TItem="LogEntryDbStorable" Property="ServiceCode" Title="Код сервиса" />
        <RadzenDataGridColumn TItem="LogEntryDbStorable" Property="MessageType" Title="Тип сообщения" />
        <RadzenDataGridColumn TItem="LogEntryDbStorable" Property="Message" Title="Текст сообщения" />
    </Columns>
</RadzenDataGrid>