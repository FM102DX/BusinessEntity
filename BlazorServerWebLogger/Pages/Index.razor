@page "/"
@using Radzen
@using Radzen.Blazor
@using SampleOnlineMall.WebLogger.Models
@using BlazorServerWebLogger.Pages
@using BlazorServerWebLogger.Components

<PageTitle>LoggerMain</PageTitle>

<h1>LoggerMain</h1>

<div class="main-logger-content">

    <div class="main-logger-table">
        <RadzenDataGrid TItem="LogEntryDbStorable" 
                        Data="@FilteredLogEntries" 
                        AllowPaging="true" 
                        PageSize="90" 
                        Count="@FilteredLogEntries.Count()" 
                        RowSelect="OnRowSelect">
            <Columns>
                <RadzenDataGridColumn TItem="LogEntryDbStorable" Width="150px" Property="Timestamp" Title="Дата и время" />
                <RadzenDataGridColumn TItem="LogEntryDbStorable" Width="70px" Property="ServiceCode" Title="От" />
                <RadzenDataGridColumn TItem="LogEntryDbStorable" Width="50px" Property="MessageType" Title="Тип" />
                <RadzenDataGridColumn TItem="LogEntryDbStorable" Width="500px" Property="Message" Title="Текст" />
            </Columns>
        </RadzenDataGrid>
    </div>

    <LogMessageViewer LogEntry="@SelectedLogEntry"></LogMessageViewer>

    <div class="main-logger-widgets">

        <LoggerWidget Title="Тип сообщений">
            @foreach (var item in MessageTypeFilter)
            {
                <label style="display: block; margin-bottom: 5px;">
                    <RadzenCheckBox @bind-Value="item.Selected" TValue="bool"
                                    Change="(bool newValue) => SaveMsgTypeFilterAsync(item, newValue)" />
                    @item.Code
                </label>
            }
        </LoggerWidget>

        <LoggerWidget Title="Отправитель">
            @foreach (var item in ServiceCodeFilter)
            {
                <label style="display: block; margin-bottom: 5px;">
                    <RadzenCheckBox @bind-Value="item.Selected"
                                    TValue="bool"
                                    Change="(bool newValue) => SaveSrvCodesFilterAsync(item, newValue)" />
                    @item.Code
                </label>
            }

        </LoggerWidget>

        <LoggerWidget Title="Статистика">
            <p>Общее количество записей: @TotalLogsCount</p>
        </LoggerWidget>

        <LoggerWidget Title="Генератор логов">
            <RadzenSwitch TValue="bool" Value="@(LoggerMainViewSettings?.LogGenerationIsOn ?? false)" Change="OnLogGenerationToggle" />
        </LoggerWidget>
        
        <LoggerWidget Title="Удалить все">
            <button class="btn btn-danger" style="margin-top: 10px;" @onclick="DeleteAllRecords">Удалить все</button>
        </LoggerWidget>

        <LoggerWidget Title="Dubug">
            <p><span>1</span>@SavedCatsDisp</p>
            <p><span>2</span>@SavedCatsNonDisp</p>
            <p><span>3</span>@SavedMsgTypesDisp</p>
            <p><span>4</span>@SavedMsgTypesNonDisp</p>
        </LoggerWidget>

    </div>

</div>